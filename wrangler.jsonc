{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cc-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CC_MCP_DO",
        "class_name": "CcMcpObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects are supported on the Cloudflare Workers Free plan
      "new_sqlite_classes": [
        "CcMcpObject"
      ]
    }
  ]
}
