{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cc-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "cc.pants.place",
      "custom_domain": true
    }
  ],
  "vars": {
    "REQUIRE_CF_ACCESS": "true"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.lua"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BRIDGE_DO",
        "class_name": "CcMeshBridge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CcMeshBridge"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "cc-mesh-catalog",
      "database_id": "b740905c-b6da-4c6c-a361-3860f17d92a8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACT_BUCKET",
      "bucket_name": "cc-mesh-artifacts"
    }
  ]
}
